# Heavy model artifacts — always ignore (per-file, not per-dir)
*.ckpt
*.pt
*.pth
*.npy
*.npz

# Raw dataset + experimental sandboxes — too heavy for git.
# Paper drafts and working docs stay local; only scripts/fig_architecture.tex is tracked.
/data/
/experiments/
/paper/ref_papers
wandb/

# Local tooling state
.claude/
.claude.local.md
.venv/

# OS / Python
__pycache__/
.DS_Store

# Stray / ephemeral one-offs
tea_debug.log
test.synctex.gz

# LaTeX build artifacts (when compiling outside scripts/make_architecture_diagram.py)
*.aux
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.bbl
paper/submission/*.log

# Note on results/:
#   The blanket `/results/` rule was removed so that lightweight artifacts
#   (markdown tables, CSVs, json summaries, png/pdf figures, logs) land in
#   version control — gives us a paper-history fallback if something is lost.
#   Checkpoints (*.pt/*.pth/*.ckpt) and cached features (data/**/*.npy) stay
#   excluded via the extension rules above, so large files stay local.
#
#   The exception below re-admits the per-fold prediction arrays. They are the
#   evidence base for every number in the paper — 10 MB for all 413 of them —
#   so tracking them lets anyone re-derive the tables and audit a cell without
#   re-running 20+ h of training. Feature caches under /data/ are unaffected:
#   that directory is excluded wholesale, and a directory exclusion cannot be
#   undone by a file negation.
!results/**/*.npz

# Credentials — never commit. Kaggle auth lives in ~/.kaggle/kaggle.json;
# a copy in the repo root is a live API key one `git add -A` away from publication.
kaggle.json
*.kaggle.json

# Bulk transfer artifacts pulled off the A100 box (features/preds tarballs plus
# that machine's agent session history). Reproducible from results/ + data/.
/vm_portable_export/

# Submission bundle — derived from paper/submission/article.tex, rebuilt on demand.
/paper/submission.zip

# The submitted manuscript that was rejected. Kept locally as the revision
# baseline, but it must not sit in a public repo that the resubmission cites
# as its code link — a reader would find the superseded version alongside the
# current one. The current manuscript is paper/submission/article.tex.
/Trustworthy AI for Diabetic Retinopathy Grading.docx
