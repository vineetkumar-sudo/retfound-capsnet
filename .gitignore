# Heavy model artifacts — always ignore (per-file, not per-dir)
*.ckpt
*.pt
*.pth
*.npy
*.npz

# Raw dataset + experimental sandboxes — too heavy for git.
# Paper drafts and working docs stay local; only scripts/fig_architecture.tex is tracked.
/data/
/experiments/
/paper/ref_papers
wandb/

# Local tooling state
.claude/
.claude.local.md
.venv/

# OS / Python
__pycache__/
.DS_Store

# Stray / ephemeral one-offs
tea_debug.log
test.synctex.gz

# LaTeX build artifacts (when compiling outside scripts/make_architecture_diagram.py)
*.aux
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.bbl
paper/submission/*.log

# Note on results/:
#   The blanket `/results/` rule was removed so that lightweight artifacts
#   (markdown tables, CSVs, json summaries, png/pdf figures, logs) land in
#   version control — gives us a paper-history fallback if something is lost.
#   The heavy artifacts (*.pt, *.npz, *.npy) are already excluded via the
#   extension rules above, so large files stay local.

# Credentials — never commit. Kaggle auth lives in ~/.kaggle/kaggle.json;
# a copy in the repo root is a live API key one `git add -A` away from publication.
kaggle.json
*.kaggle.json

# Bulk transfer artifacts pulled off the A100 box (features/preds tarballs plus
# that machine's agent session history). Reproducible from results/ + data/.
/vm_portable_export/

# Submission bundle — derived from paper/submission/article.tex, rebuilt on demand.
/paper/submission.zip

# Superseded MPS-era result tables, kept on disk only as a provenance trail.
# The canonical GPU equivalents are monotone_decode_table.*, clinical_metrics_table.*
# and ordinal_conformal_table.*; these older files use different filenames, so
# leaving them tracked invites quoting the wrong numbers into the paper.
/results/legacy_product/
/results/legacy_difference/
/results/clinical_table.csv
/results/clinical_table.md
/results/decoder_ablation.md
